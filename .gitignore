# =========================================================================
#  Lesion Atlas
#
#  This repo will never contain a photograph. The rule below is deliberately
#  blunt: ALL raster and video formats are ignored everywhere, with no
#  exceptions carved out. Anything the project needs to look at is either
#  generated by a command or fetched by a script.
#
#  If you ever find yourself wanting to `git add -f` an image, don't.
# =========================================================================

# ---- images and video: blanket ban, no exceptions -----------------------
*.jpg
*.jpeg
*.JPG
*.JPEG
*.png
*.PNG
*.heic
*.HEIC
*.heif
*.HEIF
*.tif
*.tiff
*.TIF
*.TIFF
*.bmp
*.gif
*.webp
*.raw
*.dng
*.cr2
*.nef
*.arw
*.mp4
*.mov
*.MOV
*.avi
*.mkv

# ---- the data root (normally outside the repo, but belt and braces) -----
data/
/data
**/data/raw/
**/data/derived/
**/data/atlas/
*.sqlite3
*.sqlite3-shm
*.sqlite3-wal
*.db

# ---- generated outputs --------------------------------------------------
reports/
logs/
docs/fiducial/
models/weights/
*.ckpt
*.pth
*.pt
*.task
*.onnx
*.safetensors

# ---- test fixtures are all downloaded or generated ----------------------
tests/fixtures/

# ---- python -------------------------------------------------------------
.venv/
venv/
env/
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
dist/
build/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.ipynb_checkpoints/

# ---- editors / os -------------------------------------------------------
.vscode/
.idea/
*.swp
*.swo
Thumbs.db
ehthumbs.db
desktop.ini
.DS_Store

# ---- secrets / local config --------------------------------------------
.env
.env.*
*.local
secrets.json
